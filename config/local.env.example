# Portable bundle defaults. Personal passwords/tokens are deliberately absent.
DATA_SOURCE=json
DATABASE_URL=
LLM_BACKEND=openai-compatible
LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_API_KEY=local
LLM_MODEL=ternary-bonsai-2-27b
LLM_DEFAULT_PROFILE=configured
LLM_VISIBLE_PROFILES=configured,naive-n05-flash-int4-experimental
LLM_DISPLAY_NAME=Ternary Bonsai 2 27B
LLM_DESCRIPTION=本机文本与视觉模型；仅在显式选择后加载
LLM_FAMILY=Ternary Bonsai 2
LLM_PARAMETER_SIZE_B=27
LLM_CONTEXT_TOKENS=32768
LLM_SUPPORTED_MODES=light,medium,ultra
LLM_MAX_OUTPUT_TOKENS=4096
# Disable model launches on first run. Enable explicitly when ready to infer.
LOCAL_MODEL_SWITCHING=false
COWAGENT_BASE_URL=http://127.0.0.1:9876
DEMO_WRITES_ENABLED=false
REMOTE_KNOWLEDGE_ENABLED=false
NEXT_PUBLIC_CALENDAR_URL=https://lumaflow-sales-hub.vercel.app
