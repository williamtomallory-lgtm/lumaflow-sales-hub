{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": [
    "lumaflow"
  ],
  "model": "lumaflow/configured",
  "small_model": "lumaflow/configured",
  "provider": {
    "lumaflow": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LumaFlow 本地模型网关",
      "options": {
        "baseURL": "http://127.0.0.1:3000/api/v1/work-engine/models",
        "apiKey": "{env:LUMAFLOW_GATEWAY_KEY}"
      },
      "models": {
        "configured": {
          "name": "Ternary Bonsai 2 27B（LumaFlow 网关）",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    }
  }
}
