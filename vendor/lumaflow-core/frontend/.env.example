# PostgreSQL connection used only on the server. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=

# Fail instead of falling back to the empty/local runtime store when PostgreSQL is unavailable.
POSTGRES_REQUIRED=false

# Maximum number of pooled PostgreSQL connections used by the Next.js server.
PG_POOL_MAX=10

# Persistent API writes are off by default. In production, prefer real OIDC/session auth.
LUMAFLOW_WRITES_ENABLED=false

# Optional server-to-server credential for write endpoints. Use a long random value.
API_WRITE_TOKEN=

# These values configure only the "configured" model-selector profile.
# The built-in local-qwen3-8b profile needs no env file; use npm run local:setup.
# Backend: vllm, ollama (Qwen3 no-thinking), or openai-compatible.
# Keep the model endpoint on loopback/private LAN; no NEXT_PUBLIC_ model credentials.
LLM_BACKEND=vllm
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=local
LLM_MODEL=lumaflow-qwen
LLM_TIMEOUT_MS=120000

# Per-generation output ceiling, including thinking tokens: integer 256–32768.
# Choose a value supported by the model's context window and available memory.
LLM_MAX_OUTPUT_TOKENS=8192
# In openai-compatible mode, FAST/NORMAL/DEEP select output budgets only.
# Thinking and tool-parser support must be configured in that runtime itself.

# Optional display metadata for the configured profile (server-side only).
# Bonsai example: LLM_MODEL=ternary-bonsai-2-27b, LLM_BACKEND=openai-compatible,
# LLM_BASE_URL=http://127.0.0.1:8081/v1, LLM_DEFAULT_PROFILE=configured.
LLM_DISPLAY_NAME=
LLM_DESCRIPTION=
LLM_FAMILY=
LLM_PARAMETER_SIZE_B=
LLM_CONTEXT_TOKENS=
LLM_DEFAULT_PROFILE=
# Optional comma-separated restriction, e.g. configured to hide removed Qwen weights.
# Omit this variable to retain the normal three-profile catalog.

# Optional server-to-server token for /api/v1/assistant/chat. Browser calls use same-origin protection.
ASSISTANT_API_TOKEN=

# Private local website-to-CowAgent knowledge bridge. Generated by
# node scripts/configure-agent-library.mjs; never expose in NEXT_PUBLIC_ values.
LUMAFLOW_KNOWLEDGE_TOKEN=
